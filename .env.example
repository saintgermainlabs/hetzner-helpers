# Hetzner Robot Webservice credentials
# Create/manage these under Robot > Settings > Webservice and app settings.
# These are NOT your Hetzner account login — they're the separate webservice user/password.
#
# Copy to .env and fill in real values:  cp .env.example .env
# Quote values containing shell metacharacters, e.g. ROBOT_PASS='p@ss(w0rd)!'

ROBOT_USER=your-webservice-user
ROBOT_PASS='your-webservice-password'
SERVER_IP=your.server.ip.address
