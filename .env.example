# Hetzner Robot webservice credentials
# Create under Robot → Settings → Webservice and app settings.
# These are NOT your Hetzner account login.

# Copy to .env:  cp .env.example .env
# Quote values with shell metacharacters:  ROBOT_PASS='p@ss(w0rd)!'

ROBOT_USER=your-webservice-user
ROBOT_PASS='your-webservice-password'

# Optional defaults used by recover / reset / reboot-to-disk when omitted on the CLI
SERVER_NUMBER=
SERVER_IP=

# Optional path to the OpenSSH public key to inject into rescue
# (default: ~/.ssh/id_ed25519.pub, then id_rsa.pub)
SSH_PUBKEY=

# Private key for rescue SSH (install-keys / provision scripts)
# SSH_KEY=~/.ssh/id_ed25519

# Installed-system root block device (install-keys / provision)
# ROOT_PART=/dev/md2
